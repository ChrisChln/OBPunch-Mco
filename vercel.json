{
  "routes": [
    {
      "src": "/api/package-staffing-sync",
      "dest": "/api/package-metrics-transfer?job=package-staffing-sync"
    },
    {
      "src": "/api/dashboard-attendance-snapshot-expected",
      "dest": "/api/attendance-auto-checkout?job=dashboard-attendance-snapshot&mode=expected"
    },
    {
      "src": "/api/dashboard-attendance-snapshot-actual",
      "dest": "/api/attendance-auto-checkout?job=dashboard-attendance-snapshot&mode=actual"
    },
    {
      "src": "/api/dashboard-attendance-snapshot",
      "dest": "/api/attendance-auto-checkout?job=dashboard-attendance-snapshot"
    },
    {
      "src": "/api/(.*)",
      "dest": "/api/$1"
    },
    {
      "handle": "filesystem"
    },
    {
      "src": "/(.*)",
      "dest": "/index.html"
    }
  ],
  "crons": [
    {
      "path": "/api/attendance-auto-checkout",
      "schedule": "5 9 * * *"
    },
    {
      "path": "/api/attendance-auto-checkout",
      "schedule": "5 10 * * *"
    },
    {
      "path": "/api/dashboard-attendance-snapshot-expected",
      "schedule": "55 8 * * *"
    },
    {
      "path": "/api/todo-recurring-sync",
      "schedule": "5 9 * * *"
    },
    {
      "path": "/api/package-staffing-sync",
      "schedule": "10 10 * * *"
    },
    {
      "path": "/api/consumable-alert-sync",
      "schedule": "15 16 * * *"
    }
  ]
}
